rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated admin
    function isAdmin() {
      return request.auth != null &&
             request.auth.token != null &&
             (request.auth.token.role == 'admin' || request.auth.token.role == 'panel');
    }

    // Events - Public read access for mobile apps
    match /events/{eventId} {
      // Anyone can read events
      allow read: if true;

      // Only authenticated admins can write (web app via server actions)
      allow create, update, delete: if isAdmin();

      // Event registrations subcollection - no direct access from mobile
      // Must use REST API endpoint
      match /registrations/{registrationId} {
        allow read: if isAdmin();
        allow write: if false; // Only via REST API
      }
    }

    // Team Members - Public read for active members only
    match /teamMembers/{memberId} {
      // Mobile apps can only read active team members
      allow read: if resource.data.status == 'active';

      // Only authenticated admins can write
      allow create, update, delete: if isAdmin();
    }

    // Team Categories - Public read
    match /teamCategories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Jobs - Public read
    match /jobs/{jobId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Jobs metadata
    match /jobs_meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notifications - Public read
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Applications - No direct access from mobile
    // Must use REST API endpoints
    match /applications/{applicationId} {
      allow read: if isAdmin();
      allow write: if false; // Only via REST API
    }

    // Auth tokens - Backend only
    match /authTokens/{tokenId} {
      allow read, write: if false; // Only server can access
    }

    // Visitors analytics - Backend only
    match /visitors/{visitorId} {
      allow read: if isAdmin();
      allow write: if false; // Only via middleware
    }

    // Panels configuration - Admin only
    match /panels/{panelId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Settings - Public read, admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
