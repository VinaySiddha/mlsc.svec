# ==============================================================================
# MLSC HUB - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local (for local development) or add to Vercel Settings
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE ARCHITECTURE SWITCH
# ------------------------------------------------------------------------------
# Set to "new" to use PostgreSQL + Heavy Storage (bypasses Firebase completely)
# Set to "firebase" (or leave blank) to use legacy Firebase
DATA_PROVIDER="new"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL - Supabase / Neon / Docker) - NO ORM
# ------------------------------------------------------------------------------
# Supabase Transaction / PgBouncer pooler connection string:
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:your_password@db.your_project.supabase.co:6543/postgres?sslmode=require"

# Set to "false" ONLY for local Docker postgres testing without SSL
DATABASE_SSL="true"

# ------------------------------------------------------------------------------
# 3. HEAVY STORAGE (Cloudflare R2 / S3-Compatible)
# ------------------------------------------------------------------------------
# Zero egress fees, 10 GB free tier.
# NOTE: If left empty, storage automatically falls back to local /public/uploads/
STORAGE_PROVIDER="s3_compatible"
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="mlsc-storage"
R2_PUBLIC_URL="https://pub-yourbucketid.r2.dev"

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SESSIONS
# ------------------------------------------------------------------------------
# 32+ character random secret used by jose to sign admin & interview panel JWTs
JWT_SECRET="generate_a_secure_random_jwt_secret_here_32_characters_long"

# ------------------------------------------------------------------------------
# 5. AI / GENKIT FLOWS (Google Gemini API - Free Tier)
# ------------------------------------------------------------------------------
# Required for candidate evaluation, summary, and auto-generated email flows
# Get free key from: https://aistudio.google.com/
GOOGLE_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# ------------------------------------------------------------------------------
# 6. EMAIL BROADCASTS & NOTIFICATIONS (Nodemailer via Gmail)
# ------------------------------------------------------------------------------
# Use your Google Account's 16-character App Password (not your Gmail login password)
GMAIL_USER="yourclub@gmail.com"
GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"
FROM_EMAIL="MLSC SVEC <yourclub@gmail.com>"

# ------------------------------------------------------------------------------
# 7. OPTIONAL INTEGRATIONS (Payments & Jobs)
# ------------------------------------------------------------------------------
# Cashfree Payment Gateway (for paid events, if used):
CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"
NEXT_PUBLIC_CASHFREE_MODE="TEST" # "TEST" or "PRODUCTION"

# RapidAPI JSearch (for external hiring/jobs aggregation page):
JSEARCH_API_KEY="your_rapidapi_jsearch_key"

# ------------------------------------------------------------------------------
# 8. LEGACY FIREBASE (Only needed if DATA_PROVIDER is set to "firebase")
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
# NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-app"
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789"
# NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abcdef"
