# ==============================================================================
# MLSC Portal - New Low-Cost Architecture Environment Variables
# (Zero Firebase, Zero AWS billing required)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL - Supabase / Neon / Local Docker) - NO ORM NEEDED
# ------------------------------------------------------------------------------
# Free Supabase or Neon Connection String:
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mlsc_db"
DATABASE_SSL="true" # Set to "false" only for local docker development

# ------------------------------------------------------------------------------
# 2. HEAVY STORAGE (Cloudflare R2 - 10GB Free, $0 Egress/Bandwidth Fees)
# ------------------------------------------------------------------------------
# If left empty, storage automatically falls back to local /public/uploads/
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="mlsc-storage"
R2_PUBLIC_URL="https://pub-xxxxxx.r2.dev" # Or your custom domain like https://assets.yourdomain.com

# ------------------------------------------------------------------------------
# 3. ADMIN AUTHENTICATION (Unchanged - Jose JWT)
# ------------------------------------------------------------------------------
JWT_SECRET="your_secure_random_jwt_secret_here"

# ------------------------------------------------------------------------------
# 4. EMAIL (Nodemailer via Gmail App Password - Free)
# ------------------------------------------------------------------------------
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"

# ------------------------------------------------------------------------------
# 5. AI FLOWS (Google Gemini API - Free Tier)
# ------------------------------------------------------------------------------
GOOGLE_API_KEY="your_free_gemini_api_key"
